include locations/global
include translations/16085_hamus

Bind Npc 16085 Zone 21

On greeting
    Say "I handle items purchased from the [Power-Up Store]. Which items will you use?"
    Topic "Change ID" goto change_id
    Topic "Minerva Clothing" goto minerva_clothing
    Topic "Existing Minerva Clothing" goto existing_minerva_clothing
    Topic "Pathos' Glove" goto pathos_glove
    Goto close

On change_id
    If player has 800032000
        Open rename panel
    Else
        Say "To change your ID you need the [ID Change Scroll].\nThey can be purchased at the [Power-Up Store]."
        Topic "Where can I find it?" do
            Map power_up_item

On minerva_clothing
    Say "Minerva Clothing is recommended for those seeking a different look.\nYou need each Power-up store's Minerva Clothing Certificate to make the exchange."
    Topic "Valkyrie Armor" goto valkyrie_armor
    Topic "Valkyrie Helmet" goto valkyrie_helmet
    Topic "Gryphon's Armor" goto gryphon_armor
    Topic "Gryphon's Helmet" goto gryphon_helmet
    Topic "Bahamut Armor" goto bahamut_armor
    Topic "Bahamut Helmet" goto bahamut_helmet
    Topic "Transparent Minerva Armor" goto transparent_armor
    Topic "Transparent Minerva Helmet" goto transparent_helmet
    Topic "Back" goto greeting

On valkyrie_armor
    If player has 508057000
        Goto valkyrie_armor_options
    Else
        Say "It requires a [Minerva Armor Certificate]. Please check again."
        Topic "OK." goto close

On valkyrie_armor_options
    Say "There are many options available to you with Minerva Clothing. Select your desired option."
    Topic "HP +200" goto valkyrie_armor_options_1
    Topic "Defense Power +30" goto valkyrie_armor_options_2
    Topic "Increases Base Experience for Monster Kills gained by 4%" goto valkyrie_armor_options_3
    Topic "Base Noah for Monster Kills  drop rate +6%" goto valkyrie_armor_options_4
    Topic "Back" goto minerva_clothing

On valkyrie_armor_options_1
    Say "You have selected Valkyrie Armor HP +200 Nice isn't it? Do you really want it?"
    Topic "Receive item" do
        Trade 1 of 508057000 for 1 of 508011441 for 30 days
    Topic "Back" goto valkyrie_armor_options

On valkyrie_armor_options_2
    Say "You have selected Valkyrie Armor Defense +30. Nice isn't it? Do you really want it?"
    Topic "Receive item" do
        Trade 1 of 508057000 for 1 of 508011442 for 30 days
    Topic "Back" goto valkyrie_armor_options

On valkyrie_armor_options_3
    Say "You have selected Valkyrie's Armor, which increases Base Experience for Monster Kills gained by 4%. Are you sure you want to receive this item?"
    Topic "Receive item" do
        Trade 1 of 508057000 for 1 of 508011443 for 30 days
    Topic "Back" goto valkyrie_armor_options

On valkyrie_armor_options_4
    Say "You have selected Valkyrie's Armor, which increases Base Noah for Monster Kills  drop rate by 6%. Are you sure you want to receive this item?"
    Topic "Receive item" do
        Trade 1 of 508057000 for 1 of 508011444 for 30 days
    Topic "Back" goto valkyrie_armor_options

