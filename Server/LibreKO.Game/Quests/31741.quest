Bind Npc 31741

On greeting
    Say "Hello, I'm Julia and I'm here to help Moira"
    Topic "Exchange Dason's Gift" goto dasons_gift
    Topic "Close" goto close

On dasons_gift
    Say "Please select one of the following options"
    Topic "Dason's Delicate Gift" goto open_delicate_gift
    Topic "Dason's Shining Gift" goto open_shining_gift
    Topic "Dason's Glorious Gift" goto open_glorious_gift
    Topic "Close" goto close

On open_delicate_gift
    Transaction
        Take 1 of 931685000
        Give random from dasons_delicate_gift
    Else
        Say "I'm afraid that is not what I've asked for"
        Topic "Close" goto close

On open_shining_gift
    Transaction
