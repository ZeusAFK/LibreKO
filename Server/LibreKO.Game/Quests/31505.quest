On event_800
    Say how_are_you_i
    If player in zone 106
        Topic "Receive for Free" goto event_801
    Else
        Topic "Receive for Free" goto event_801
        Topic "Receive with Noah" do
            If player level > 34 and player level < 61 and player has > 150000 of 900000000
                Cast 302344
                If the last step worked
                    Cast 302344
                    Cast 302332
                    Cast 302329
                    Cast 490223
                    Take 150000 coins
                Else
                    Cast 302332
                    Cast 302329
                    Cast 490223
                    Take 150000 coins
                    Say "You are already completed. Have a good time."
                    Topic "Close" goto close
            Else if player level > 60 and player has > 200000 of 900000000
                Goto event_806
            Else
                Say please_select_your_method
                Topic "Confirm" goto close
        Topic "Receive with Symbol of Victory" goto close

On event_801
    If player in zone 106
        Goto event_806
    Else
        If player level < 35
            Cast 302344
            If the last step worked
                Cast 302344
                Cast 302331
                Cast 302328
                Cast 490223
            Else
                Cast 302331
                Cast 302328
                Cast 490223
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
        Else
            Say information_on_the_npc
            Topic "Confirm" goto close

On event_806
    Cast 302344
    If the last step worked
        Cast 302344
        Cast 302332
        Cast 302329
        Cast 490223
        Take 200000 coins
    Else
        Cast 302332
        Cast 302329
        Cast 490223
        Take 200000 coins
        Say "You are already completed. Have a good time."
        Topic "Close" goto close
