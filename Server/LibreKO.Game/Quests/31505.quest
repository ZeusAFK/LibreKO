include translations/31505_kenchant

Bind Npc 31505

On greeting
    Say how_are_you_i
    If player in zone 106
        Topic "Receive all 4 buffs" goto event_800
    Else
        Topic "[Buff][Noah/Symbol of Victory]" goto event_200
        Topic "[Spirit Alseids] Of mounting" do
            If player lacks 900667000
                Say "You don't have buff coupon."
                Topic "Confirm" goto close
        Topic "Settlement support free of charge buff" do
            If player lacks 900667000
                Say "You don't have buff coupon."
                Topic "Confirm" goto close
        Topic "Receive all 4 buffs" goto event_800
    Goto close

On event_200
    If player level < 35
        Say "Knights between levels 1 and 35 can use it free of charge. The list of buffs which a user can receive is as follows: |#Shout for charge: Attack power 10%|# Firm will: Defensive power 100|# Endless patience: Enhancement of physical strength by 500 |The price is 30000 Noah per buff. It can also be paid by one [sign of victory]."
        Topic "Yes" goto event_201
        Topic "No" goto close
    Else if player level > 34 and player level < 61
        Say "This is the list of buffs which a user between levels 36 and 60 can receive: |#Shout for charge: Attack power 10%|# Unbeatable will: Defensive power 150|# Unlimited patience: Enhancement of physical strength by 800|The price is 30000 Noah per buff. It can also be paid by two [signs of victory]."
        Topic "Yes" goto event_202
        Topic "No" goto close
    Else if player level > 60
        Say "This is the list of buffs which a user between levels 61 and 83 can receive:|# Shout for charge: Attack power 10%|# Unyielding will: Defensive power 200|# Extreme patience: Enhancement of physical strength by 1000|The price is 50000 Noah per buff."
        Topic "Yes" goto event_203
        Topic "No" goto close

On event_201
    Say information_on_the_npc
    Topic "Confirm" goto event_204

On event_202
    If player has 900017000
        Say information_on_the_npc
        Topic "Confirm" goto event_219
    Else
        Say information_on_the_npc
        Topic "Confirm" goto event_205

On event_203
    If player has 900017000
        Say information_on_the_npc
        Topic "Confirm" goto event_225
    Else
        Say information_on_the_npc
        Topic "Confirm" goto event_206

On event_204
    Say "Please select the buff you would like to receive.|# Shout for charge : Attack power 10%|# Firm will: Defensive power 100|# Endless patience: Enhancement of physical strength by 500"
    Topic "[Attack] Shout for charge" do
        Cast 302344
        If the last step worked
            Cast 302344
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
        Else
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
    Topic "[Defense] Firm will" do
        Cast 302331
        If the last step worked
            Cast 302331
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
        Else
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
    Topic "[Physical strength] Endless patience" do
        Cast 302328
        If the last step worked
            Cast 302328
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
        Else
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
    Topic "Strong legs [Go]" do
        Cast 490223
        If the last step worked
            Cast 490223
            Say "You are already completed. Have a good time."
            Topic "Close" goto close
        Else
            Say "You are already completed. Have a good time."
            Topic "Close" goto close

On event_205
    If player has < 30000 of 900000000
        Say please_select_your_method
        Topic "Where can I find it?" goto close
    Else
        Say please_select_the_buff
        Topic "[Attack] Shout for charge" do
            Cast 302344
            If the last step worked
                Cast 302344
                Take 30000 coins
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
            Else
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
        Topic "[Defense] Unbeatable will" do
            Cast 302332
            If the last step worked
                Cast 302332
                Take 30000 coins
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
            Else
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
        Topic "[Physical strength] Unlimited patience" do
            Cast 302329
            If the last step worked
                Cast 302329
                Take 30000 coins
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
            Else
                Say "You are already completed. Have a good time."
                Topic "Close" goto close
        Topic "Strong legs [Go]" do
