On despair_keys
    If player has 379081000 and player has 379082000
        Say "You have the chosen key. You can move to the 10th or the 20th floor."
        Topic "Transport to 10th floor of the Abyss of Despair" do
            Take 379081000
            Teleport party to 32 at 250 192
        Topic "Transport to 20th floor of the Abyss of Despair" do
            Take 379082000
            Teleport party to 32 at 450 437
        Topic "I will use it next time." goto close
    Else if player has 379081000
        Say "You have the first key of the Abyss of Despair. You can transport down to the dungeon Underground Level 10."
        Topic "Transport to 10th floor of the Abyss of Despair" do
            Take 379081000
            Teleport party to 32 at 250 192
        Topic "I will use it next time." goto close
    Else if player has 379082000
        Say "You have the second key of the Abyss of Despair. You can transport down to the dungeon Underground Level 20."
        Topic "Transport to 20th floor of the Abyss of Despair" do
            Take 379082000
            Teleport party to 32 at 450 437
        Topic "I will use it next time." goto close
    Else
        Say "You don't have the teleport key."
        Topic "Confirm" goto close

On hell_keys
    If player has 379083000 and player has 379084000
        Say "You have the chosen key. You can move to the 8th or the 16th floor."
        Topic "Transport to 8th floor of the Abyss of Hell" do
            Take 379083000
            Teleport party to 33 at 189 458
        Topic "Transport to 18th floor of the Abyss of Hell" do
            Take 379084000
            Teleport party to 33 at 444 458
        Topic "I will use it next time." goto close
    Else if player has 379083000
