Bind Npc 7001

On greeting
    If npc trigger < 41000
        If player has 379111000
            Say "You have the key of the Abyss of Hell. Would you like to transport?"
            Topic "Use the Abyss of Hell" goto hell_key
            Topic "Do not use the Abyss of Hell" goto despair_floor
        Else
            Goto despair_floor
    Else if npc trigger < 43000
        Goto hell_floor
    Else
        Say "Do you want to leave the Dragon Cave?"
        Topic "Yes. I want to leave." do
            Teleport 33 at 445 459
        Topic "No. I don't want to leave." goto close
    Goto close

